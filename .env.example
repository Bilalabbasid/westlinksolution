# ---------------------------------------------------------------------------
# Westlink Solution — environment configuration
# Copy to .env.local for development. Never commit real values.
# ---------------------------------------------------------------------------

# Public site URL used for canonical links, sitemap, robots, and Open Graph.
# Production: https://westlinksolution.com (or https://www.westlinksolution.com if the live site redirects to www).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Indexing is OFF unless this is "true" AND NODE_ENV=production.
# Leave unset on preview deployments.
ALLOW_INDEXING=false

# Storage (optional). Default is email-only: every submission is emailed to
# NOTIFY_EMAIL_TO and nothing is stored on the server. In that mode the form
# returns an error if the email cannot be sent, so the Resend variables below
# are required.
DATABASE_URL=none
# To also keep a copy in a database, use one of these instead:
# a) Any PostgreSQL connection string:
# DATABASE_URL=postgres://user:password@host:5432/westlink
# DATABASE_SSL=true
# b) SQLite file for local development only:
# DATABASE_URL=file:./data/westlink.db
# c) Supabase REST (takes priority over DATABASE_URL; apply db/supabase.sql first):
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Notification email via Resend (https://resend.com). All three are required.
# NOTIFY_EMAIL_FROM must use a domain verified in Resend. Comma-separate
# multiple recipients in NOTIFY_EMAIL_TO.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=abbasi.bilal2000@gmail.com
NOTIFY_EMAIL_FROM=Westlink Solution <info@westlinksolution.com>

# Send applicants a confirmation email after a partner application.
# Only "true" enables it; the UI only mentions the email when it was sent.
SEND_CONFIRMATION_EMAILS=false

# CRM / webhook delivery. Each submission is POSTed as JSON. When the secret is
# set, requests carry X-Westlink-Signature: sha256=<HMAC of the body>.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Google Places API (New) for address autocomplete. Server-side only; the key
# never reaches the browser. Manual entry works without it.
GOOGLE_PLACES_API_KEY=

# Cloudflare Turnstile bot protection (optional). Both keys are required.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Salt for one-way hashing of IP addresses stored with submissions.
IP_HASH_SALT=change-me-to-a-long-random-string
